# Copie para .env e ajuste. Nunca commite o .env.

# --- Postgres (docker compose local) ---
POSTGRES_USER=kokka
POSTGRES_PASSWORD=kokka
POSTGRES_DB=kokka
DATABASE_URL=postgres://kokka:kokka@localhost:5432/kokka

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Worker ---
WORKER_HEALTH_PORT=3001

# --- Web / auth ---
APP_URL=http://localhost:3000
# Gere um valor próprio em produção: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-troque-em-producao-0123456789

# --- Admin (seed: pnpm db:seed-admin; rodar de novo troca a senha) ---
ADMIN_EMAIL=admin@kokka.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Admin
