# Copie para .env e ajuste. Nunca commite o .env.

# --- Postgres (docker compose local) ---
POSTGRES_USER=kokka
POSTGRES_PASSWORD=kokka
POSTGRES_DB=kokka
# Porta no host; mude aqui e em DATABASE_URL juntos.
POSTGRES_PORT=5433
DATABASE_URL=postgres://kokka:kokka@localhost:5433/kokka

# --- Redis ---
# Porta no host; mude aqui e em REDIS_URL juntos.
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380

# --- Storage S3 ---
# Local: SeaweedFS do docker compose (bucket e CORS criados pelo serviço s3-init).
# Produção: Cloudflare R2 -> S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com,
# S3_REGION=auto e as chaves de um token de API do R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kokka
S3_ACCESS_KEY_ID=kokka
S3_SECRET_ACCESS_KEY=kokka-dev-secret
S3_FORCE_PATH_STYLE=true

# --- Worker ---
WORKER_HEALTH_PORT=3001
# Jobs de mídia processados ao mesmo tempo (vídeos usam um núcleo cada).
MEDIA_CONCURRENCY=2

# --- Web / auth ---
APP_URL=http://localhost:3000
# Gere um valor próprio em produção: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-only-secret-troque-em-producao-0123456789

# --- Admin (seed: pnpm db:seed-admin; rodar de novo troca a senha) ---
ADMIN_EMAIL=admin@kokka.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Admin
