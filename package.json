{
  "name": "kokka",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "lint": "pnpm --filter @kokka/web typegen && eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release:tag": "node scripts/tag-release.mjs",
    "db:generate": "pnpm --filter @kokka/db generate",
    "db:check": "pnpm --filter @kokka/db check",
    "db:migrate": "pnpm --filter @kokka/db migrate",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "dev:web": "pnpm --filter @kokka/web dev",
    "dev:worker": "pnpm --filter @kokka/worker dev",
    "db:seed-admin": "pnpm --filter @kokka/db seed-admin"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
